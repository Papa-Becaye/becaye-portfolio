# ── Site ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://votre-domaine.com

# ── Informations personnelles (laisser vide pour masquer) ──
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_WHATSAPP=            # numéro international sans + (ex: 221770000000)
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_CV_FR=               # ex: /cv/becaye-fall-cv-fr.pdf
NEXT_PUBLIC_CV_EN=
NEXT_PUBLIC_CV_AR=
NEXT_PUBLIC_PHOTO=               # ex: /images/becaye.jpg
NEXT_PUBLIC_AVAILABILITY=available   # available | limited | unavailable

# ── Formulaire de contact (au moins un canal) ────────
# 1) Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
# 2) Webhook / Formspree (URL d'endpoint)
CONTACT_FORM_ENDPOINT=
# 3) PostgreSQL (stockage des messages, optionnel)
# DATABASE_URL=postgresql://user:password@host:5432/dbname
